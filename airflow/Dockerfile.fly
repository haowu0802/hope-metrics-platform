FROM apache/airflow:2.10.4-python3.12

USER root
COPY airflow/dags/ /opt/airflow/dags/
COPY dbt/ /opt/hope/dbt/
COPY airflow/scripts/fly-entrypoint.sh /fly-entrypoint.sh
RUN chmod +x /fly-entrypoint.sh \
    && chown -R airflow:root /opt/hope/dbt /opt/airflow/dags

USER airflow
RUN pip install --no-cache-dir "dbt-postgres>=1.8.0,<2"
WORKDIR /opt/hope/dbt
# Package install only; no warehouse connection required.
RUN dbt deps

ENV DBT_PROFILES_DIR=/home/airflow/.dbt
WORKDIR /opt/airflow

ENTRYPOINT ["/fly-entrypoint.sh"]
